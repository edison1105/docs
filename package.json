{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "bench:vp-theme:build": "pnpm bench:vp-theme:build:vdom && pnpm bench:vp-theme:build:vapor",
    "bench:vp-theme:build:vdom": "vite build --config bench/vp-theme-spa/vite.vdom.config.mjs",
    "bench:vp-theme:build:vapor": "vite build --config bench/vp-theme-spa/vite.vapor.config.mjs",
    "bench:vp-theme": "node bench/vp-theme-spa/bench.mjs",
    "preinstall": "npx only-allow pnpm",
    "type": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vue/repl": "^4.7.1",
    "@vue/theme": "^2.4.0",
    "dynamics.js": "^1.1.5",
    "gsap": "^3.14.2",
    "vitepress": "^2.0.0-alpha.17",
    "vue": "3.6.0-beta.10"
  },
  "devDependencies": {
    "@types/body-scroll-lock": "^3.1.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.5.2",
    "@vitejs/plugin-vue": "6.0.5",
    "esbuild": "^0.28.0",
    "oxc-minify": "^0.124.0",
    "playwright": "^1.59.1",
    "typescript": "^5.9.3",
    "vite": "8.0.7",
    "vitepress-plugin-group-icons": "^1.7.3",
    "vitepress-plugin-llms": "^1.12.0",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "vitepress>vite": "npm:vite@8.0.7",
      "vue": "3.6.0-beta.10",
      "@vue/compiler-core": "3.6.0-beta.10",
      "@vue/compiler-dom": "3.6.0-beta.10",
      "@vue/shared": "3.6.0-beta.10"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}
